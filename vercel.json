{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/healthz",
      "dest": "backend/index.js"
    },
    {
      "src": "/metrics",
      "dest": "backend/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/server.js"
    }
  ]
}
