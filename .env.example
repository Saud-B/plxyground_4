# Backend
PORT=3011
DB_PROVIDER=sqlite
DATABASE_URL=./backend/data/plxyground.db
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:19006,http://localhost:3012
JSON_BODY_LIMIT=1mb
MOCK_ANALYTICS=false
MOCK_ALERTS=false

# Email / password reset
LOCAL_STUB_EMAIL=true
EMAIL_PROVIDER=resend
EMAIL_FROM=PLXYGROUND <no-reply@plxyground.local>
RESEND_API_KEY=

# Frontend
EXPO_PUBLIC_API_BASE_URL=http://localhost:3011

# Admin
API_BASE_URL=http://localhost:3011
ALERTS_REFRESH_MS=30000
