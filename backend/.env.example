PORT=3011
DB_PROVIDER=sqlite
DATABASE_URL=./data/plxyground.db
JWT_SECRET=replace_with_long_random_secret
# Short‑lived access tokens; override per environment if needed
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:19006,http://localhost:3012
JSON_BODY_LIMIT=1mb

# Optional media hosting
MEDIA_PROVIDER=none
S3_BUCKET_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email provider + local fallback
EMAIL_PROVIDER=
EMAIL_API_KEY=
LOCAL_STUB_EMAIL=true

# Feature toggles
MOCK_ANALYTICS=false
MOCK_ALERTS=false
ADMIN_ALERTS_REFRESH_MS=30000

# Refresh token TTL (in days)
REFRESH_TOKEN_TTL_DAYS=7
